{
  "hostname": {
    "transient": "fastvm-opensuse"
  },
  "product": {
    "id": "openSUSE_Leap"
  },
  "root": {
    "hashedPassword": false,
    "password": "testtest"
  },
  "scripts": {
    "post": [
      {
        "content": "#!/bin/bash\nsystemctl enable sshd.service",
        "name": "enable-sshd.sh"
      },
      {
        "content": "#!/bin/bash\nfstrim -a",
        "name": "fstrim.sh"
      }
    ]
  },
  "software": {
    "onlyRequired": true,
    "patterns": [
      "minimal_base",
      "selinux"
    ]
  },
  "storage": {
    "boot": {
      "configure": true
    },
    "drives": [
      {
        "alias": "LTu9QaeyQh",
        "partitions": [
          {
            "delete": true,
            "search": {
              "ifNotFound": "skip"
            }
          }
        ],
        "search": {
          "condition": {
            "name": "/dev/sda"
          },
          "ifNotFound": "error"
        }
      }
    ],
    "mdRaids": [],
    "volumeGroups": [
      {
        "logicalVolumes": [
          {
            "filesystem": {
              "mountOptions": [],
              "path": "/",
              "reuseIfPossible": false,
              "type": "xfs"
            },
            "name": "root_lv",
            "size": {
              "max": 5000000000,
              "min": 5000000000
            }
          },
          {
            "filesystem": {
              "mountOptions": [],
              "path": "swap",
              "reuseIfPossible": false,
              "type": "swap"
            },
            "name": "swap_lv",
            "size": {
              "max": 256000000,
              "min": 256000000
            }
          }
        ],
        "name": "os16vg",
        "physicalVolumes": [
          {
            "generate": [
              "LTu9QaeyQh"
            ]
          }
        ]
      }
    ]
  }
}
